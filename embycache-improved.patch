+                    fixed[u.key] = u.bytes
+                    changed = True
+            if not changed:
+                break
+        for u in flexible:
+            if u.key not in fixed:
+                self.select(u, cap, share)
+        for u in active:
+            if u.key in explicit:
+                self.select(u, float(explicit[u.key]), share)
+        for u in active:
